# Copy to .env (never commit .env)
# Test engine: wdio (WebdriverIO) or playwright. Choose ONE per project. See README.
TEST_ENGINE=wdio
BASE_URL=https://staging.example.com
# Optional: only if the site has a login. Leave empty otherwise.
TEST_USER=
TEST_PASSWORD=
HEADLESS=false
MAX_INSTANCES=2

# Publishing tests to GitHub (used only by `npm run qa:publish`)
# Token: fine-grained, this repo only, Contents + Pull requests + Workflows = Read and write
GITHUB_REPO=https://github.com/<owner>/<repo>
GITHUB_TOKEN=
GITHUB_BASE_BRANCH=main
